// Cloudflare: the website served as static files. html_handling "none" keeps the .html addresses exactly as they are;
// _cf/site.js runs when no file matches, and first for the order page (each site serves its own branded copy); (folder index pages, extensionless links, 404).
{
  "name": "awefloral-site",
  "compatibility_date": "2026-06-01",
  "main": "_cf/site.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/track.html", "/en/track.html"] },
  "workers_dev": true,
  "observability": { "enabled": true }
}
