// Cloudflare: the website served as static files. html_handling "none" keeps the .html addresses exactly as they are;
// _cf/site.js runs first for everything but /assets/ and /img/ (awefloral.com and rawnbatat.com each serve their own pages); (folder index pages, extensionless links, 404).
{
  "name": "awefloral-site",
  "compatibility_date": "2026-06-01",
  "main": "_cf/site.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/*", "!/assets/*", "!/img/*"] },
  "workers_dev": true,
  "observability": { "enabled": true }
}
